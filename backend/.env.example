# --- App ---
APP_NAME=AuditOS
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+psycopg2://auditos:auditos_password@localhost:5432/auditos
POSTGRES_USER=auditos
POSTGRES_PASSWORD=auditos_password
POSTGRES_DB=auditos

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- AI Providers (fill in your own keys; never commit real keys) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
